# StoLink AI Agent - Environment Variables Example
# 이 파일을 .env로 복사한 후 값을 입력하세요.
# cp .env.example .env

# =============================================================================
# Application
# =============================================================================
APP_NAME=StoLink AI Agent
DEBUG=true

# =============================================================================
# AWS Bedrock Configuration (deprecated - kept for backward compatibility)
# =============================================================================
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# Google Gemini Configuration (LLM용 - 필수)
# https://aistudio.google.com/app/apikey 에서 API Key 발급
# =============================================================================
GOOGLE_API_KEY=

# =============================================================================
# RabbitMQ Configuration (Agent Queue - 필수)
# 로컬: localhost / 운영: Private IP
# =============================================================================
RABBITMQ_AGENT_HOST=localhost
RABBITMQ_AGENT_PORT=5673
RABBITMQ_AGENT_USER=guest
RABBITMQ_AGENT_PASSWORD=guest
RABBITMQ_AGENT_VHOST=stolink
RABBITMQ_ANALYSIS_QUEUE=stolink.analysis.queue

# =============================================================================
# Spring Backend Callback (필수)
# =============================================================================
SPRING_CALLBACK_URL=http://localhost:8080

# =============================================================================
# PostgreSQL Configuration (필수)
# 로컬: localhost / 운영: RDS Endpoint
# =============================================================================
POSTGRESQL_URL=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=stolink
POSTGRESQL_USERNAME=stolink
POSTGRESQL_PASSWORD=stolink123

# =============================================================================
# Neo4j Configuration (Graph DB - 필수)
# 로컬: bolt://localhost:7687 / 운영: neo4j+s://...
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=stolink123
